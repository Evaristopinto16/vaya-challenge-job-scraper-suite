NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_indexer
DATABASE_SSL=false

# Cron: every 6 hours
SYNC_CRON=0 */6 * * *

# HTTP
REQUEST_TIMEOUT_MS=20000
USER_AGENT=JobIndexer/1.0 (+contact: admin@example.com)

# Workable: API access token and account subdomain required
WORKABLE_TOKEN=
WORKABLE_ACCOUNT=

# Example sources. Replace values with real company/board identifiers.
# ATS source records:
SOURCES_JSON=[
  {"name":"Example Greenhouse","platform":"greenhouse","identifier":"example"},
  {"name":"Example Lever","platform":"lever","identifier":"example"},
  {"name":"Example Ashby","platform":"ashby","identifier":"example"},
  {"name":"Example SmartRecruiters","platform":"smartrecruiters","identifier":"EXAMPLE"},
  {"name":"Example Workable","platform":"workable","identifier":"example"}
]
